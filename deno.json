{
  "imports": {
    "alea": "https://esm.sh/alea@1.0.1?pin=v132",
    "seed": "https://deno.land/x/seed@1.0.0/index.ts",
    "dnt": "https://deno.land/x/dnt@0.28.0/mod.ts",
    "gaussian": "https://deno.land/x/gaussian@v0.1.0/mod.ts",
    "@std/fs": "jsr:@std/fs@^1.0.8",
    "@std/assert": "jsr:@std/assert@^1.0.8"
  },
  "tasks": {
    "test": "deno test",
    "build:npm": "deno run -A tasks/build-npm.ts",
    "build:cli": "cd cli && deno task build:cli",
    "dev": "cd www && deno run -A dev.ts",
    "start": "cd www && deno run -A main.ts",
    "staticalize": "deno run -A jsr:@frontside/staticalize@0.2.6/cli --site http://localhost:8000 --output=built --base=https://graphgen-data.netlify.app && deno run -A fix-static-css.ts"
  },
  "lint": {
    "rules": {
      "exclude": ["prefer-const", "require-yield", "no-inner-declarations"]
    },
    "exclude": ["build", "cli", "www/"]
  },
  "fmt": {
    "exclude": ["README.md", "build/", "cli", "www/"]
  },
  "test": {
    "exclude": ["build", "cli", "www/"]
  }
}
